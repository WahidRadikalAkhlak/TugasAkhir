<?xml version="1.0" encoding="utf-8"?>
<android.widget.ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cart.Penjual.PenawaranPenjualActivity"
    tools:ignore="MissingClass"
    android:id="@+id/main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/item_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="10dp"
            android:background="@color/light_grey">

            <ImageView
                android:id="@+id/iv_user_image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/avatar"
                android:clipToOutline="true"
                android:shape="oval"/>

            <!-- User details (name, job, rating) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center_vertical">

                <!-- User Name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/nama_pengguna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nama_pengguna"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="start"
                    android:textStyle="bold"/>

                <!-- Job Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/pekerjaan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pekerjaan"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:layout_gravity="start"/>

            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_7" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kirim_pesan"
            android:id="@+id/btn_kirim_pesan"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/dark_grey"
            android:textColor="@color/black" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_1" />

        <RelativeLayout
            android:id="@+id/orderan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider_1"
            android:layout_marginStart="15dp"
            >
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/nomor"
                android:text="@string/Nomor"
                android:layout_marginTop="15dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/nomor_order"
                android:layout_centerVertical="true"
                android:text="@string/no_orderan"
                android:layout_toEndOf="@+id/nomor"
                android:layout_marginStart="3dp"
                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rv_statusorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/orderan"
            android:layout_marginStart="15dp"
            >
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/status"
                android:text="@string/status_order"
                android:layout_marginTop="15dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/status_order"
                android:layout_centerVertical="true"
                android:text="@string/statusorder"
                android:layout_toEndOf="@+id/status"
                android:layout_marginStart="3dp"
                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rv_tanggal_waktu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_below="@+id/rv_statusorder">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/tanggal"
                android:text="@string/Tanggal"
                android:layout_marginTop="15dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tanggal_order"
                android:layout_centerVertical="true"
                android:text="@string/tanggal_order"
                android:layout_toEndOf="@+id/tanggal"
                />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/waktu_order"
                android:layout_centerVertical="true"
                android:text="@string/waktu_order"
                android:layout_marginStart="30dp"
                android:layout_toEndOf="@+id/tanggal_order"
                />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/order_time"
                android:layout_centerVertical="true"
                android:text="@string/waktu"
                android:layout_marginStart="3dp"
                android:layout_toEndOf="@+id/waktu_order"
                />
        </RelativeLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:id="@+id/divider_2" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@+id/divider_2"
            android:layout_marginTop="10dp"
            android:id="@+id/rv_produk_keranjang"
            tools:listitem="@layout/item_keranjang_produk" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:id="@+id/divider_3" />

        <RelativeLayout
            android:id="@+id/rl_tawarkan_harga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/divider_3">
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/menawarkan_harga"
            android:text="@string/menawarkan_harga"
            android:textSize="15sp"
            android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/harga_tawaran"
                android:text="@string/harga_tawaran"
                android:textSize="30sp"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/menawarkan_harga"
                android:textStyle="bold" />
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/darker_gray"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_alignParentBottom="true">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proses_pesanan"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tolak_tawaran_harga"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                android:backgroundTint="@color/light_grey"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </LinearLayout>

</android.widget.ScrollView>
