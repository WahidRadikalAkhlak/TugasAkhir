<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_daftar_penjual"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".Account.Penjual.DaftarPenjualActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Judul Halaman -->
        <TextView
            android:id="@+id/tv_daftar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/tv_daftarbisnis"
            android:textColor="@android:color/black"
            android:textSize="22sp"
            android:fontFamily="@font/poppinssemibold" />

        <!-- Nomor Telepon -->
        <TextView
            android:id="@+id/tv_no_hp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nomor Telepon Lain"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_no_hp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:hint="Nomor WhatsApp"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_no_hp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Alamat Toko -->
        <TextView
            android:id="@+id/tv_alamat_toko"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat Toko"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_alamat_toko"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat Toko Anda">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_alamat_toko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_share_lokasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link Alamat lokasi"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_share_lokasi"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Link Lokasi Anda Pada Google Maps">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_share_lokasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nomor Izin Usaha -->
        <TextView
            android:id="@+id/tv_no_izin_usaha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Izin Usaha"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_no_izin_usaha"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="No Izin Usaha">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_no_izinusaha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Deskripsi Profil -->
        <TextView
            android:id="@+id/tv_deskripsi_profil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi Profil"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_deskripsi_profil"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deskripsi Profil">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_deskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sosial Media -->
        <TextView
            android:id="@+id/tv_sosial_media"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sosial Media"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_sosial_media"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sosial Media">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sosial_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tombol Daftar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_daftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="@string/daftar"
            android:textStyle="bold" />

        <android.widget.ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:elevation="4dp"
            android:indeterminate="true"
            android:layout_centerInParent="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </LinearLayout>
</ScrollView>
