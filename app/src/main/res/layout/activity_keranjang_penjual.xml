<?xml version="1.0" encoding="utf-8"?>
<android.widget.ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cart.KeranjangPesananActivity"
    tools:ignore="MissingClass"
    android:id="@+id/main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/item_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="10dp"
            android:background="@color/light_grey">

            <ImageView
                android:id="@+id/iv_user_image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                android:clipToOutline="true"
                android:shape="oval"/>

            <!-- User details (name, job, rating) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center_vertical">

                <!-- User Name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/nama_pengguna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nama_pengguna"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="start"
                    android:textStyle="bold"/>

                <!-- Job Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/pekerjaan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pekerjaan"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:layout_gravity="start"/>

            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_7" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kirim_pesan"
            android:id="@+id/btn_kirim_pesan"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/dark_grey"
            android:textColor="@color/black" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_1" />

        <RelativeLayout
            android:id="@+id/orderan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider_1"
            android:layout_marginStart="15dp"
            >
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/nomor"
                android:text="@string/Nomor"
                android:layout_marginTop="15dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/nomor_order"
                android:layout_centerVertical="true"
                android:text="@string/no_orderan"
                android:layout_toEndOf="@+id/nomor"
                android:layout_marginStart="3dp"
                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rv_statusorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/orderan"
            android:layout_marginStart="15dp"
            >
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/status"
                android:text="@string/status_order"
                android:layout_marginTop="15dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/status_order"
                android:layout_centerVertical="true"
                android:text="@string/statusorder"
                android:layout_toEndOf="@+id/status"
                android:layout_marginStart="3dp"
                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rv_tanggal_waktu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_below="@+id/rv_statusorder">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/tanggal"
                android:text="@string/Tanggal"
                android:layout_marginTop="15dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tanggal_order"
                android:layout_centerVertical="true"
                android:text="@string/tanggal_order"
                android:layout_toEndOf="@+id/tanggal"
                />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/waktu_order"
                android:layout_centerVertical="true"
                android:text="@string/waktu_order"
                android:layout_marginStart="30dp"
                android:layout_toEndOf="@+id/tanggal_order"
                />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/order_time"
                android:layout_centerVertical="true"
                android:text="@string/waktu"
                android:layout_marginStart="3dp"
                android:layout_toEndOf="@+id/waktu_order"
                />
        </RelativeLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:id="@+id/divider_2" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@+id/divider_2"
            android:layout_marginTop="10dp"
            android:id="@+id/rv_produk_keranjang"
            tools:listitem="@layout/item_keranjang_produk" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:id="@+id/divider_3" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tambah_produk_baru"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/dark_grey"
            android:textColor="@color/black"
            android:layout_marginTop="8dp"
            />
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_4" />
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/metode_pembayaran"
                android:textStyle="bold"
                android:id="@+id/metode_pembayaran"
                />
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@+id/metode_pembayaran"
                >

                <RadioButton
                    android:id="@+id/radio_ambil_ditempat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bayar Di Tempat"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:checked="true"
                    />

            </RadioGroup>
        </RelativeLayout>
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_5" />
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pesan_kepada_penjual"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:id="@+id/pesan_kepada_penjual"
                />
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginEnd="15dp"
                android:hint="Isi Pesan ..."
                android:background="@drawable/border_backround"
                android:layout_below="@+id/pesan_kepada_penjual" />
        </RelativeLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/divider_6" />

        <LinearLayout
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/darker_gray"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_alignParentBottom="true">

            <!-- Menampilkan item_count dan total_price secara horizontal -->
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="start"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/item_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Item: 2"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginEnd="16dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/Harga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/harga"
                    android:layout_marginEnd="50dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/HargaBarang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/harga_barang"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </RelativeLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proses_pesanan"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/batalkan_proses_pesanan"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                android:backgroundTint="@color/light_grey"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </LinearLayout>

</android.widget.ScrollView>
