    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/deskripsi_produk"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp" />
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider_5"
        android:layout_alignStart="@id/nama_product">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ulasan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ulasan"
            android:layout_centerVertical="true"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/svg_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/ulasan"
            android:src="@drawable/rate_review"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txt_ulasan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_ulasan"
            android:layout_toEndOf="@id/svg_rate"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/baca_ulasan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/baca_ulasan"
            android:layout_centerVertical="true"
            android:layout_marginRight="15dp"
            android:layout_alignParentEnd="true"
            android:textStyle="bold" />
    </RelativeLayout>
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kirim_pesan"
        android:id="@+id/btn_kirim_pesan"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/btn_buy"
        app:cornerRadius="16dp"
        app:strokeColor="@color/black"
        app:strokeWidth="2dp"
        android:backgroundTint="@color/white"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/buy"
        android:id="@+id/btn_buy"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        app:cornerRadius="16dp"
        android:textColor="@color/fontColor"
        android:backgroundTint="@color/btn_color" />

</RelativeLayout>
