<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_info_product"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Katalog.Product.InfoProductActivity">

    <ImageView
        android:id="@+id/img_product"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@color/black"
        android:contentDescription="@string/gambar_produk" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/nama_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nama_produk"
        android:layout_below="@+id/img_product"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="15dp"
        android:textSize="25sp"
        android:fontFamily="@font/poppinsextrabold"/>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/jenis_produk"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true" />

    <RelativeLayout
        android:id="@+id/rl_usernameaddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider_6"
        android:layout_alignStart="@id/nama_product"
        android:layout_marginTop="10dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Added by: User Name"
            android:textSize="16sp"
            android:fontFamily="@font/poppinsmedium"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address :"
            android:textSize="16sp"
            android:fontFamily="@font/poppinsmedium"
            android:layout_marginRight="15dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <ImageButton
        android:id="@+id/btnLike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/img_product"
        android:layout_alignParentEnd="true"
        android:layout_margin="15dp"
        android:layout_marginRight="15dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/like_product"
        android:src="@drawable/like"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#E91E63" />

    <TextView
        android:id="@+id/likesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 Likes"
        android:textSize="16sp"
        android:layout_marginRight="15dp"
        android:layout_below="@id/btnLike"
        android:layout_alignParentEnd="true"
        android:textColor="@android:color/darker_gray" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/jenis_produk"
            android:layout_width="wrap_content"
            android:textSize="16sp"
            android:layout_alignStart="@id/nama_product"
            android:layout_below="@+id/nama_product"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinsmedium"
            android:text="@string/jenis_produk" />

    <RelativeLayout
        android:id="@+id/layout_harga_tersedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_usernameaddress"
        android:layout_alignStart="@id/nama_product"
        android:layout_marginTop="10dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/Harga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/harga" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/HargaBarang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/Harga"
            android:text="@string/harga_barang"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textstock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tersedia"
            android:layout_marginRight="15dp"
            android:layout_alignParentEnd="true" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_50kg"
            android:layout_marginRight="15dp"
            android:layout_below="@id/textstock"
            android:textStyle="bold"
            android:layout_alignStart="@+id/textstock"/>
    </RelativeLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_harga_tersedia"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:id="@+id/divider_2" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/deskripsi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider_2"
        android:layout_alignStart="@id/nama_product"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:text="@string/deskripsi" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/deskripsi_produk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/deskripsi"
        android:layout_alignStart="@id/nama_product"
        android:layout_marginTop="8dp"
        android:text="@string/deskripsi" />

