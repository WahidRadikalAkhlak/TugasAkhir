<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:elevation="2dp"
    android:radius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- User Information Section -->
        <LinearLayout
            android:id="@+id/ll_item_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_item_image"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/avatar"
                android:contentDescription="@string/image"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nama_pengguna"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Komunikasi Rating Section -->
        <TextView
            android:id="@+id/tv_komunikasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Komunikasi"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <RatingBar
            android:id="@+id/ratingbarkomunikasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="0"
            android:layout_marginTop="4dp" />

        <!-- Kualitas Rating Section -->
        <TextView
            android:id="@+id/tv_kualitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kualitas"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <RatingBar
            android:id="@+id/ratingbarkualitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="0"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tV_keterangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keterangan Ulasan"
            android:fontFamily="@font/poppinsextrabold"
            android:textSize="16sp"
            android:layout_marginTop="30dp" />

        <TextView
            android:id="@+id/tv_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Comment"
            android:fontFamily="@font/poppinsmedium"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
