<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Katalog.Product.BottomSheetBuyActivity">

    <!-- CardView container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#F3F4F6">

        <!-- RelativeLayout to contain ProgressBar and content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ProgressBar - Centered in the layout -->
            <android.widget.ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:elevation="4dp"
                android:indeterminate="true"
                android:layout_centerInParent="true"/>

            <!-- Main content inside the CardView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Product Name and Type -->
                <TextView
                    android:id="@+id/productName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nama_produk"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/productType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jenis_produk"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Product Image Section -->
                <ImageView
                    android:id="@+id/img_product"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/image_icon"
                    android:contentDescription="@string/gambar_produk"/>

                <!-- Price and Stock Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Harga (/Kg)"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/harga"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp. 50.000"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tersedia"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/stock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50 Kg"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quantity and Total Price Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kurang"
                            android:layout_width="40dp"
                            android:backgroundTint="@color/btn_color"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/white" />

                        <EditText
                            android:id="@+id/banyak_pesanan"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="0" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tambah"
                            android:layout_width="40dp"
                            android:backgroundTint="@color/btn_color"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/totalharga"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Harga"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/total_harga"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp. 0"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Diskon dan Harga Minimal Diskon Section -->
                <LinearLayout
                    android:id="@+id/llhargadiskon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga Diskon"
                        android:layout_gravity="end"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hargadiskon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp. 0"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:textColor="#FF0000" />
                </LinearLayout>

                <!-- New Section: Diskon Syarat Pembelian -->
                <TextView
                    android:id="@+id/diskonSyarat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Syarat diskon: Pembelian lebih dari Rp 100.000"
                    android:textColor="#FF0000"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"
                    android:gravity="center" />

                <!-- Add to Cart Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_keranjang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/fontColor"
                    android:backgroundTint="@color/btn_color"
                    android:text="Tambah ke Keranjang"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
