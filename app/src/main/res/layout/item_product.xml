<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="230dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/border_backround"
        android:padding="6dp">

        <!-- Gambar Produk + Label Diskon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/img_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Product Image"
                android:background="@drawable/border_backround"
                android:backgroundTint="@color/border_color"/>

            <TextView
                android:id="@+id/discountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/rounded_discount"
                android:text="10% OFF"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"/>
        </RelativeLayout>

        <!-- Nama Produk -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nama_produk"
            android:textColor="#000000"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"/>

        <!-- Jenis Produk -->
        <TextView
            android:id="@+id/tvProductType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jenis • Tipe"
            android:textSize="11sp"
            android:textColor="#8e8e8e"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Deskripsi -->
        <TextView
            android:id="@+id/deskripsi_produk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi produk..."
            android:textSize="10sp"
            android:textColor="#8e8e8e"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Stok -->
        <TextView
            android:id="@+id/tv_stock_available"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stok: 10 kg"
            android:textSize="10sp"
            android:textColor="#8e8e8e"/>

        <!-- Harga -->
        <TextView
            android:id="@+id/HargaBarang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp 100.000"
            android:textSize="12sp"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <!-- Rating -->
        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:rating="0"
            android:layout_marginTop="2dp"
            style="?android:attr/ratingBarStyleSmall"/>

        <!-- Likes -->
        <TextView
            android:id="@+id/likesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Likes"
            android:textSize="10sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
