<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/border_color"
    app:strokeWidth="2dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="8dp"
android:background="@drawable/border_backround">

<!-- Product Image -->
    <ImageView
        android:id="@+id/img_product"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="@drawable/border_backround"
        android:contentDescription="Product Image"
        android:backgroundTint="@color/border_color"
        android:layout_marginBottom="8dp" />


<!-- Product Name -->
<TextView
    android:id="@+id/tvProductName"
    android:text="@string/nama_produk"
    android:textSize="14sp"
    android:textColor="#000000"
    android:fontFamily="sans-serif-medium"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginTop="6dp" />

<!-- Product Type -->
<TextView
    android:id="@+id/tvProductType"
    android:text="Jenis • Tipe Produk"
    android:textSize="12sp"
    android:textColor="#8e8e8e"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginTop="2dp" />

<!-- Product Description -->
<TextView
    android:id="@+id/deskripsi_produk"
    android:text="@string/deskripsi"
    android:textSize="11sp"
    android:textColor="#8e8e8e"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginTop="2dp" />

<!-- Stock Available -->
<TextView
    android:id="@+id/tv_stock_available"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/stok"
    android:textSize="11sp"
    android:textColor="#8e8e8e"
    android:layout_marginTop="2dp" />

<!-- Price Section -->
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:layout_marginTop="6dp">

    <TextView
        android:id="@+id/harga"
        android:text="Harga:"
        android:textSize="13sp"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/HargaBarang"
        android:text="Rp 100.000"
        android:textSize="13sp"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp" />
</LinearLayout>

<!-- Rating Bar -->
<androidx.appcompat.widget.AppCompatRatingBar
    android:id="@+id/ratingBar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:numStars="5"
    android:rating="0"
    android:stepSize="0.5"
    android:layout_gravity="start"
    style="?android:attr/ratingBarStyleSmall"/>

<!-- Likes Count -->
<TextView
    android:id="@+id/likesCount"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="0 Likes"
    android:textSize="11sp"
    android:layout_marginRight="8dp"
    android:layout_marginTop="8dp"
    android:layout_gravity="end"
    android:textColor="@android:color/darker_gray" />

</LinearLayout>
    </androidx.cardview.widget.CardView>
