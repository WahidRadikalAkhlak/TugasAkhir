<!-- item_keranjang_produk.xml -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/border_backround">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Product Image"
            android:background="@android:color/darker_gray"
            android:scaleType="centerInside"/>

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/productName"
                android:text="Nama Produk"
                android:textSize="16sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/productType"
                android:text="Jenis • Tipe Produk"
                android:textSize="14sp"
                android:textColor="#8e8e8e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/description"
                android:text="Deskripsi produk ..."
                android:textSize="12sp"
                android:textColor="#8e8e8e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/totalPrice"
                android:text="1 (kg): Rp. 50.000"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Quantity Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginStart="16dp">

            <TextView
                android:text="Terhitung (/kg)"
                android:textSize="12sp"
                android:textColor="#8e8e8e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <Button
                    android:id="@+id/mines"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/remove"
                    android:backgroundTint="@color/dark_grey"/>

                <TextView
                    android:id="@+id/banyak_produk"
                    android:text="1"
                    android:textSize="16sp"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"/>

                <Button
                    android:id="@+id/plus"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:text="+"
                    android:background="@drawable/add"
                    android:backgroundTint="@color/dark_grey"/>
            </LinearLayout>

            <!-- Delete Icon -->
            <ImageView
                android:id="@+id/btnDeleteOrder"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/delete"
                android:layout_marginTop="8dp"
                android:contentDescription="Delete"
                android:layout_gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
